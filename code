    public int getStudentId() {
        return studentId;
    }

    public String getName() {
        return name;
    }

    public String getBranch() {
        return branch;
    }

    public double getCgpa() {
        return cgpa;
    }

    public String getSkills() {
        return skills;
    }

    public int getBacklogs() {
        return backlogs;
    }

    // Display student details
    public void displayStudent() {

