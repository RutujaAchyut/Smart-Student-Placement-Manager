public class PlacementManager{
    private java.util.ArrayList<Student> students;
private java.util.ArrayList<Company> companies;
private java.util.ArrayList<Application> applications;

public PlacementManager() {
    students = new java.util.ArrayList<>();
    companies = new java.util.ArrayList<>();
    applications = new java.util.ArrayList<>();
}

// =====================================================
// STUDENT METHODS
// =====================================================

public void addStudent(Student student) {
    students.add(student);
    System.out.println("Student added successfully.");
}

public void displayStudents() {

    if (students.isEmpty()) {
        System.out.println("No students found.");
        return;
    }

    System.out.println();
    System.out.println("======================================");
    System.out.println("           STUDENT LIST");
    System.out.println("======================================");

    for (Student student : students) {
        student.displayStudent();
    }
}

public Student findStudent(int studentId) {

    for (Student student : students) {
        if (student.getStudentId() == studentId) {
            return student;
        }
    }

    return null;
}

// =====================================================
// COMPANY METHODS
// =====================================================

public void addCompany(Company company) {
    companies.add(company);
    System.out.println("Company added successfully.");
}

public void displayCompanies() {

    if (companies.isEmpty()) {
        System.out.println("No companies found.");
        return;
    }

    System.out.println();
    System.out.println("======================================");
    System.out.println("           COMPANY LIST");
    System.out.println("======================================");

    for (Company company : companies) {
        company.displayCompany();
    }
}

public Company findCompany(int companyId) {

    for (Company company : companies) {
        if (company.getCompanyId() == companyId) {
            return company;
        }
    }

    return null;
}

// =====================================================
// APPLICATION METHODS
// =====================================================

public void addApplication(Application application) {
    applications.add(application);
    System.out.println("Application submitted successfully.");
}

public void displayApplications() {

    if (applications.isEmpty()) {
        System.out.println("No applications found.");
        return;
    }

    System.out.println();
    System.out.println("======================================");
    System.out.println("         APPLICATION LIST");
    System.out.println("======================================");

    for (Application application : applications) {
        application.displayApplication();
    }
}

// =====================================================
// UPDATE APPLICATION STATUS
// =====================================================

public void updateApplicationStatus(int applicationId, String newStatus) {

    for (Application application : applications) {

        if (application.getApplicationId() == applicationId) {

            application.setStatus(newStatus);

            System.out.println();
            System.out.println("======================================");
            System.out.println("     APPLICATION STATUS UPDATED");
            System.out.println("======================================");
            System.out.println("Application ID : " + applicationId);
            System.out.println("New Status     : " + newStatus);
            System.out.println("======================================");

            return;
        }
    }

    System.out.println("Application not found.");
}

// =====================================================
// SMART COMPANY MATCH
// =====================================================

public void calculateMatch(int studentId, int companyId) {

    Student student = findStudent(studentId);
    Company company = findCompany(companyId);

    if (student == null) {
        System.out.println("Student not found.");
        return;
    }

    if (company == null) {
        System.out.println("Company not found.");
        return;
    }

    int score = 0;

    // CGPA = 40 points
    if (student.getCgpa() >= company.getMinimumCgpa()) {
        score += 40;
    }

    // Skill = 40 points
    if (student.getSkills() != null &&
        student.getSkills().toLowerCase()
        .contains(company.getRequiredSkill().toLowerCase())) {

        score += 40;
    }

    // Backlogs = 20 points
    if (student.getBacklogs() <= company.getMaximumBacklogs()) {
        score += 20;
    }

    System.out.println();
    System.out.println("======================================");
    System.out.println("          SMART COMPANY MATCH");
    System.out.println("======================================");

    System.out.println("Student : " + student.getName());
    System.out.println("Company : " + company.getCompanyName());
    System.out.println("Role    : " + company.getJobRole());
    System.out.println("Match   : " + score + "%");

    if (score >= 80) {
        System.out.println("Result  : ELIGIBLE");
    }
    else if (score >= 50) {
        System.out.println("Result  : PARTIALLY MATCHED");
    }
    else {
        System.out.println("Result  : NOT ELIGIBLE");
    }

    System.out.println("======================================");
}

// =====================================================
// SKILL GAP ANALYZER
// =====================================================

public void analyzeSkillGap(int studentId, int companyId) {

    Student student = findStudent(studentId);
    Company company = findCompany(companyId);

    if (student == null) {
        System.out.println("Student not found.");
        return;
    }

    if (company == null) {
        System.out.println("Company not found.");
        return;
    }

    System.out.println();
    System.out.println("======================================");
    System.out.println("          SKILL GAP ANALYZER");
    System.out.println("======================================");

    System.out.println("Student : " + student.getName());
    System.out.println("Company : " + company.getCompanyName());
    System.out.println("Required Skill : " + company.getRequiredSkill());

    if (student.getSkills() != null &&
        student.getSkills().toLowerCase()
        .contains(company.getRequiredSkill().toLowerCase())) {

        System.out.println("Status : Skill requirement satisfied.");

    } else {

        System.out.println("Status : Skill gap detected.");
        System.out.println(
            "Recommendation : Learn "
            + company.getRequiredSkill()
        );
    }

    System.out.println("======================================");
}

// =====================================================
// PLACEMENT READINESS SCORE
// =====================================================

public void calculateReadinessScore(int studentId) {

    Student student = findStudent(studentId);

    if (student == null) {
        System.out.println("Student not found.");
        return;
    }

    int score = 0;

    // CGPA - 40 points
    if (student.getCgpa() >= 8.5) {
        score += 40;
    }
    else if (student.getCgpa() >= 7.0) {
        score += 30;
    }
    else if (student.getCgpa() >= 6.0) {
        score += 20;
    }
    else {
        score += 10;
    }

    // Skills - 40 points
    String skills = student.getSkills();

    if (skills != null && !skills.trim().isEmpty()) {

        String[] skillList = skills.split(",");

        if (skillList.length >= 4) {
            score += 40;
        }
        else if (skillList.length >= 2) {
            score += 30;
        }
        else {
            score += 20;
        }
    }

    // Backlogs - 20 points
    if (student.getBacklogs() == 0) {
        score += 20;
    }
    else if (student.getBacklogs() <= 2) {
        score += 10;
    }

    System.out.println();
    System.out.println("======================================");
    System.out.println("       PLACEMENT READINESS SCORE");
    System.out.println("======================================");

    System.out.println("Student : " + student.getName());
    System.out.println("Score   : " + score + "/100");

    if (score >= 80) {
        System.out.println("Level   : HIGHLY READY");
    }
    else if (score >= 60) {
        System.out.println("Level   : MODERATELY READY");
    }
    else {
        System.out.println("Level   : NEEDS IMPROVEMENT");
    }

    System.out.println("======================================");
}

// =====================================================
// PLACEMENT DASHBOARD
// =====================================================

public void displayDashboard() {

    int applied = 0;
    int shortlisted = 0;
    int selected = 0;
    int rejected = 0;

    for (Application application : applications) {

        String status = application.getStatus();

        if (status == null) {
            continue;
        }

        if (status.equalsIgnoreCase("Applied")) {
            applied++;
        }
        else if (status.equalsIgnoreCase("Shortlisted")) {
            shortlisted++;
        }
        else if (status.equalsIgnoreCase("Selected")) {
            selected++;
        }
        else if (status.equalsIgnoreCase("Rejected")) {
            rejected++;
        }
    }

    System.out.println();
    System.out.println("======================================");
    System.out.println("          PLACEMENT DASHBOARD");
    System.out.println("======================================");

    System.out.println("Total Students    : " + students.size());
    System.out.println("Total Companies   : " + companies.size());
    System.out.println("Total Applications: " + applications.size());

    System.out.println();
    System.out.println("APPLICATION STATUS");
    System.out.println("--------------------------------------");

    System.out.println("Applied           : " + applied);
    System.out.println("Shortlisted       : " + shortlisted);
    System.out.println("Selected          : " + selected);
    System.out.println("Rejected          : " + rejected);

    System.out.println("======================================");
}

