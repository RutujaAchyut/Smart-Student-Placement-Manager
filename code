public class Main{
    public static void main(String[] args) {

    java.util.Scanner scanner = new java.util.Scanner(System.in);

    PlacementManager manager = new PlacementManager();

    int choice;

    do {

        System.out.println("\n========================================");
        System.out.println("     SMART STUDENT PLACEMENT MANAGER");
        System.out.println("========================================");

        System.out.println("1. Add Student");
        System.out.println("2. View Students");
        System.out.println("3. Add Company");
        System.out.println("4. View Companies");
        System.out.println("5. Smart Company Match");
        System.out.println("6. Skill Gap Analyzer");
        System.out.println("7. Placement Readiness Score");
        System.out.println("8. Apply for Company");
        System.out.println("9. View Applications");
        System.out.println("10. Update Application Status");
        System.out.println("11. Placement Dashboard");
        System.out.println("12. Career Skill Recommender");
        System.out.println("13. Exit");

        System.out.print("\nEnter your choice: ");
        choice = scanner.nextInt();

        switch (choice) {

            // =========================================
            // ADD STUDENT
            // =========================================

            case 1:

                System.out.println("\n===== ADD STUDENT =====");

                System.out.print("Enter Student ID: ");
                int studentId = scanner.nextInt();
                scanner.nextLine();

                System.out.print("Enter Name: ");
                String name = scanner.nextLine();

                System.out.print("Enter Branch: ");
                String branch = scanner.nextLine();

                System.out.print("Enter CGPA: ");
                double cgpa = scanner.nextDouble();
                scanner.nextLine();

                System.out.print("Enter Skills (comma separated): ");
                String skills = scanner.nextLine();

                System.out.print("Enter Number of Backlogs: ");
                int backlogs = scanner.nextInt();

                Student student = new Student(
                        studentId,
                        name,
                        branch,
                        cgpa,
                        skills,
                        backlogs
                );

                manager.addStudent(student);

                break;

            // =========================================
            // VIEW STUDENTS
            // =========================================

            case 2:

                manager.displayStudents();

                break;

            // =========================================
            // ADD COMPANY
            // =========================================

            case 3:

                System.out.println("\n===== ADD COMPANY =====");

                System.out.print("Enter Company ID: ");
                int companyId = scanner.nextInt();
                scanner.nextLine();

                System.out.print("Enter Company Name: ");
                String companyName = scanner.nextLine();

                System.out.print("Enter Job Role: ");
                String jobRole = scanner.nextLine();

                System.out.print("Enter Minimum CGPA: ");
                double minimumCgpa = scanner.nextDouble();
                scanner.nextLine();

                System.out.print("Enter Required Skill: ");
                String requiredSkill = scanner.nextLine();

                System.out.print("Enter Maximum Backlogs Allowed: ");
                int maximumBacklogs = scanner.nextInt();

                System.out.print("Enter Package (LPA): ");
                double packageLpa = scanner.nextDouble();

                Company company = new Company(
                        companyId,
                        companyName,
                        jobRole,
                        minimumCgpa,
                        requiredSkill,
                        maximumBacklogs,
                        packageLpa
                );

                manager.addCompany(company);

                break;

            // =========================================
            // VIEW COMPANIES
            // =========================================

            case 4:

                manager.displayCompanies();

                break;

            // =========================================
            // SMART COMPANY MATCH
            // =========================================

            case 5:

                System.out.println("\n===== SMART COMPANY MATCH =====");

                System.out.print("Enter Student ID: ");
                int matchStudentId = scanner.nextInt();

                System.out.print("Enter Company ID: ");
                int matchCompanyId = scanner.nextInt();

                manager.calculateMatch(
                        matchStudentId,
                        matchCompanyId
                );

                break;

            // =========================================
            // SKILL GAP ANALYZER
            // =========================================

            case 6:

                System.out.println("\n===== SKILL GAP ANALYZER =====");

                System.out.print("Enter Student ID: ");
                int gapStudentId = scanner.nextInt();

                System.out.print("Enter Company ID: ");
                int gapCompanyId = scanner.nextInt();

                manager.analyzeSkillGap(
                        gapStudentId,
                        gapCompanyId
                );

                break;

            // =========================================
            // PLACEMENT READINESS
            // =========================================

            case 7:

                System.out.println("\n===== PLACEMENT READINESS =====");

                System.out.print("Enter Student ID: ");
                int readinessStudentId = scanner.nextInt();

                manager.calculateReadinessScore(
                        readinessStudentId
                );

                break;

            // =========================================
            // APPLY FOR COMPANY
            // =========================================

            case 8:

                System.out.println("\n===== APPLY FOR COMPANY =====");

                System.out.print("Enter Application ID: ");
                int applicationId = scanner.nextInt();

                System.out.print("Enter Student ID: ");
                int applicationStudentId = scanner.nextInt();

                System.out.print("Enter Company ID: ");
                int applicationCompanyId = scanner.nextInt();

                Application application = new Application(
                        applicationId,
                        applicationStudentId,
                        applicationCompanyId,
                        "Applied"
                );

                manager.addApplication(application);

                break;

            // =========================================
            // VIEW APPLICATIONS
            // =========================================

            case 9:

                manager.displayApplications();

                break;

            // =========================================
            // UPDATE APPLICATION STATUS
            // =========================================

            case 10:

                System.out.println("\n===== UPDATE APPLICATION STATUS =====");

                System.out.print("Enter Application ID: ");
                int updateApplicationId = scanner.nextInt();

                System.out.println("\nSelect New Status:");
                System.out.println("1. Applied");
                System.out.println("2. Shortlisted");
                System.out.println("3. Selected");
                System.out.println("4. Rejected");

                System.out.print("\nEnter your choice: ");
                int statusChoice = scanner.nextInt();

                String newStatus;

                switch (statusChoice) {

                    case 1:
                        newStatus = "Applied";
                        break;

                    case 2:
                        newStatus = "Shortlisted";
                        break;

                    case 3:
                        newStatus = "Selected";
                        break;

                    case 4:
                        newStatus = "Rejected";
                        break;

                    default:
                        System.out.println("Invalid status choice.");
                        continue;
                }

                manager.updateApplicationStatus(
                        updateApplicationId,
                        newStatus
                );

                break;

            // =========================================
            // PLACEMENT DASHBOARD
            // =========================================

            case 11:

                manager.displayDashboard();

                break;

            // =========================================
            // CAREER RECOMMENDER
            // =========================================

            case 12:

                CareerRecommender.showRecommendations();

                break;

            // =========================================
            // EXIT
            // =========================================

            case 13:

                System.out.println("\nThank you for using");
                System.out.println("Smart Student Placement Manager!");

                break;

            default:

                System.out.println("\nInvalid choice!");
                System.out.println("Please enter a number from 1 to 13.");
        }

    } while (choice != 13);

    scanner.close();
}
}
