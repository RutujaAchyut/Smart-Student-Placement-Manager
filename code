// CAREER RECOMMENDER
// =====================================================

public void careerRecommender(int studentId) {

    Student student = findStudent(studentId);

    if (student == null) {
        System.out.println("Student not found.");
        return;
    }

    String skills = student.getSkills();

    if (skills == null) {
        skills = "";
    }

    skills = skills.toLowerCase();

    System.out.println();
    System.out.println("======================================");
    System.out.println("       CAREER SKILL RECOMMENDER");
    System.out.println("======================================");

    System.out.println("Student : " + student.getName());
    System.out.println();

    boolean found = false;

    if (skills.contains("java")) {

        System.out.println("Career : Java Developer");
        System.out.println("Learn  : Spring Boot, SQL, Git");
        System.out.println();

        found = true;
    }

    if (skills.contains("python")) {

        System.out.println("Career : Python Developer");
        System.out.println("Learn  : Django, Flask, SQL");
        System.out.println();

        found = true;
    }

    if (skills.contains("html") ||
        skills.contains("css")) {

        System.out.println("Career : Web Developer");
        System.out.println("Learn  : JavaScript, React, Node.js");
        System.out.println();

        found = true;
    }

    if (skills.contains("sql")) {

        System.out.println("Career : Data Analyst");
        System.out.println("Learn  : Excel, Power BI, Python");
        System.out.println();

        found = true;
    }

    if (!found) {

        System.out.println("No specific career recommendation found.");
        System.out.println();
        System.out.println("Start learning:");
        System.out.println("Java / Python / SQL / HTML / CSS");
    }

    System.out.println("======================================");
}
